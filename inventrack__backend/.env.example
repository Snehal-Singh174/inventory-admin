# ── Database ──────────────────────────────────────────────────────────────────
# Render provides this automatically when you link a Postgres service
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4010

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://inventrack-frontend.onrender.com
CORS_ORIGIN=https://your-frontend.onrender.com
